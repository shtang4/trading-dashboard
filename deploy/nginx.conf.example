# Reverse-proxy the dashboard on a subdomain of your Hostinger VPS.
# Save as /etc/nginx/sites-available/portfolio, then:
#   ln -s /etc/nginx/sites-available/portfolio /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# Then get HTTPS with:  certbot --nginx -d portfolio.yourdomain.com

server {
    listen 80;
    server_name portfolio.yourdomain.com;   # <-- change to your (sub)domain

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
