# Copy this file to .env and fill in real values. Never commit .env.

# Password required to view and edit the dashboard. Choose something strong.
DASHBOARD_PASSWORD=change-me-to-a-strong-password

# Secret used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it fixed so logins survive restarts.
SECRET_KEY=paste-a-long-random-hex-string-here

# Set to 1 once the site is served over HTTPS (it will be, behind nginx).
SESSION_COOKIE_SECURE=1

# Optional: seconds to cache Yahoo prices (default 60).
# PRICE_CACHE_SECONDS=60
